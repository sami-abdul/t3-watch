{
  "name": "t3-watch",
  "version": "0.1.0",
  "description": "Watches the systems you run, sets itself up from your projects, and talks to your agents over MCP.",
  "license": "MIT",
  "type": "module",
  "bin": { "t3-watch": "bin/t3-watch.js" },
  "files": ["bin", "dist", "catalog", "README.md", "LICENSE"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node src/server/cli.ts start",
    "build": "pnpm build:server && pnpm build:web && pnpm build:app",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build:app": "vite build --mode app",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.56.0",
    "motion": "14.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.10.0"
}
