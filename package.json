{
  "name": "@lfg-labs/t3-watch",
  "version": "0.5.1",
  "description": "Monitoring that sets itself up from the projects on your machine, and wakes your coding agent only when something changes.",
  "mcpName": "ai.lfglabs/t3-watch",
  "license": "MIT",
  "author": "Abdul Sami",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sami-abdul/t3-watch.git"
  },
  "homepage": "https://github.com/sami-abdul/t3-watch#readme",
  "bugs": {
    "url": "https://github.com/sami-abdul/t3-watch/issues"
  },
  "keywords": [
    "mcp",
    "monitoring",
    "uptime",
    "github-actions",
    "agents",
    "t3",
    "codex",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "t3-watch": "bin/t3-watch.js"
  },
  "files": [
    "bin",
    "dist",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/server/cli.ts start",
    "build": "pnpm build:server && pnpm build:web && pnpm build:app",
    "build:site": "node scripts/build-site.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build:app": "vite build --mode app",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.56.0",
    "motion": "14.2.0",
    "playwright-core": "1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.10.0",
  "publishConfig": {
    "access": "public"
  }
}
